{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/reminder-scheduler",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/rsvp",
      "destination": "/rsvp.html"
    },
    {
      "source": "/reminder-approval",
      "destination": "/reminder-approval.html"
    }
  ]
}
