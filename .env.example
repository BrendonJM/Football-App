# Server-side only. Powers AI training plans and AI communication drafts.
OPENAI_API_KEY=replace-with-a-new-server-side-openai-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-side only. Used by RSVP, reminder scheduler, and event email API routes.
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=TeamPro <onboarding@resend.dev>
TEAMPRO_APP_BASE_URL=https://www.teampro.co.nz
# Optional. Use for manual scheduler triggers outside the signed-in TeamPro UI.
CRON_SECRET=replace-with-a-long-random-string
# GitHub Actions reminder scheduler uses the same CRON_SECRET value via the TEAMPRO_CRON_SECRET repository secret.
# Example GitHub Actions repository secret: TEAMPRO_REMINDER_SCHEDULER_URL=https://www.teampro.co.nz/api/reminder-scheduler
PORT=3000
